<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion><RollForward>Disable</RollForward>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <InvariantGlobalization>true</InvariantGlobalization><AssemblyName>Flight.Session.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(FlightSourceRoot)/src/Flight.Data/Flight.Data.csproj" />
    <ProjectReference Include="$(FlightSourceRoot)/src/Flight.Shared/Flight.Shared.csproj" />
  </ItemGroup>
</Project>
